# 模型 API 配置（兼容 OpenAI 格式，支持任意提供商）
# pydantic-ai 通过 MODEL_API_KEY / MODEL_BASE_URL 调用 LLM
# 以下变量会自动映射：
MODEL_API_KEY=sk-your-key-here
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-pro

# PostgreSQL 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/goulong

# 环境标识（development / production，生产环境会强制检查安全配置）
ENVIRONMENT=development

# 文档原文加密密钥（生产环境必须配置，用于加密存储 parsed_content）
DATA_ENCRYPTION_KEY=

# 应用行为
LOG_LEVEL=INFO
MAX_DOCUMENT_LENGTH=8000
UPLOAD_DIR=knowledge-base/uploads

# MinerU 文档解析 API v4
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=pipeline
MINERU_ENABLE_OCR=true
MINERU_LANGUAGE=ch
MINERU_REQUEST_TIMEOUT_SECONDS=60
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_TOTAL_TIMEOUT_SECONDS=600
MINERU_MAX_ZIP_BYTES=52428800
MINERU_MAX_ZIP_MEMBERS=100
MINERU_MAX_COMPRESSION_RATIO=100
MINERU_MAX_MARKDOWN_BYTES=20971520
MINERU_MAX_JSON_BYTES=1048576
# 生产环境必填；逗号分隔精确 hostname 和/或以点开头的 suffix
MINERU_TRUSTED_HOSTS=

# 文档质量门禁
DOCUMENT_MIN_NON_WHITESPACE_CHARS=50
DOCUMENT_MIN_PRINTABLE_RATIO=0.95
DOCUMENT_MAX_REPLACEMENT_CHARACTER_RATIO=0.01
DOCUMENT_MAX_GARBLED_CHARACTER_RATIO=0.05
DOCUMENT_MAX_IMAGE_PLACEHOLDER_RATIO=0.4
DOCUMENT_MIN_VALID_PDF_PAGE_CHARS=20
DOCUMENT_MAX_PARSE_BYTES=52428800

# 文档任务重试限频（每用户固定窗口）
DOCUMENT_JOB_RETRY_RATE_LIMIT=5
DOCUMENT_JOB_RETRY_RATE_LIMIT_WINDOW=3600
DOCUMENT_ARTIFACT_RETENTION_DAYS=30

# 文件存储后端。前期默认 local；只有显式 oss 且 OSS 配置完整时才启用 OSS。
STORAGE_BACKEND=local
# OSS 留空时使用 ECS/本机本地存储 UPLOAD_DIR。
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_PREFIX=zhaodan

# JWT 认证配置
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Key 加密密钥（用于 Agent API 认证，生产环境必须更换为随机强密码）
API_KEY_ENCRYPTION_SECRET=your-secret-key-here

# Redis 连接地址（Worker 异步任务队列）
REDIS_URL=redis://localhost:6379
