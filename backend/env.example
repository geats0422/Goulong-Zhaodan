# 模型 API 配置（兼容 OpenAI 格式，支持任意提供商）
# litellm 通过 OPENAI_API_KEY / OPENAI_API_BASE 调用 LLM
# 以下变量会自动映射：
MODEL_API_KEY=sk-your-key-here
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# PostgreSQL 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/goulong

# 应用行为
LOG_LEVEL=INFO
MAX_DOCUMENT_LENGTH=8000

# JWT 认证配置
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
